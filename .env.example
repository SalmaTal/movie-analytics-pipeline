# Copier ce fichier en .env puis renseigner les valeurs (.env n'est pas versionné)

# Clé de l'API TMDB (« API Key », format v3) : https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Base PostgreSQL : postgresql://utilisateur:motdepasse@localhost:5432/cinema
DATABASE_URL=

# Jeton Hugging Face avec droit d'écriture
HF_TOKEN=
